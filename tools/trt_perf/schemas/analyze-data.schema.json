{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TensorRT performance analysis data",
  "type": "object",
  "required": ["schema_version", "model_name", "model_name_confidence", "model_components", "validation", "results"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.2"] },
    "folder": { "type": ["string", "null"] },
    "model_name": { "type": ["string", "null"] },
    "model_name_confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "model_name_evidence": { "type": "array", "items": { "type": "string" } },
    "model_components": { "type": "array", "items": { "type": "string" } },
    "validation": {
      "type": "object",
      "required": ["status", "backend_count", "passed_count", "failed_count"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "partial", "failed"] },
        "backend_count": { "type": "integer", "minimum": 0 },
        "passed_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "validation", "layers", "profile", "layer_count", "profile_count", "graph", "timing", "model", "engines", "records", "type_breakdown", "tag_breakdown", "issues"],
        "properties": {
          "label": { "type": "string" },
          "validation": {
            "type": "object",
            "required": ["status", "analysis_mode", "messages", "source_paths", "report_available"],
            "properties": {
              "status": { "type": "string", "enum": ["passed", "failed", "partial"] },
              "analysis_mode": { "type": "string" },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["level", "message"],
                  "properties": {
                    "level": { "type": "string", "enum": ["error", "warning", "info"] },
                    "message": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "source_paths": {
                "type": "object",
                "required": ["layer", "profile"],
                "properties": {
                  "layer": { "type": ["string", "null"] },
                  "profile": { "type": ["string", "null"] }
                },
                "additionalProperties": false
              },
              "report_available": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "layer_count": { "type": "integer", "minimum": 0 },
          "profile_count": { "type": "integer", "minimum": 0 },
          "graph": {
            "type": "object",
            "required": ["edge_count", "external_inputs", "graph_outputs"],
            "properties": {
              "edge_count": { "type": "integer", "minimum": 0 },
              "external_inputs": { "type": "array", "items": { "type": "string" } },
              "graph_outputs": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "count": { "type": ["integer", "null"], "minimum": 0 },
          "count_source": { "type": "string" },
          "timing": {
            "type": "object",
            "required": ["total_time_ms", "average_inference_ms", "total_percentage"],
            "properties": {
              "total_time_ms": { "type": "number" },
              "average_inference_ms": { "type": "number" },
              "total_percentage": { "type": "number" }
            },
            "additionalProperties": false
          },
          "model": {
            "type": "object",
            "required": ["name", "name_confidence", "category", "confidence", "dynamic_dims"],
            "properties": {
              "name": { "type": ["string", "null"] },
              "name_confidence": { "type": "string", "enum": ["low", "medium", "high"] },
              "name_evidence": { "type": "array", "items": { "type": "string" } },
              "components": { "type": "array", "items": { "type": "string" } },
              "category": { "type": "string" },
              "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
              "evidence": { "type": "array", "items": { "type": "string" } },
              "config_path": { "type": ["string", "null"] },
              "hidden_size": { "type": ["integer", "null"] },
              "intermediate_size": { "type": ["integer", "null"] },
              "num_layers": { "type": ["integer", "null"] },
              "num_heads": { "type": ["integer", "null"] },
              "max_position_embeddings": { "type": ["integer", "null"] },
              "sequence_length": { "type": ["integer", "null"] },
              "dynamic_dims": { "type": "boolean" },
              "input_shapes": { "type": "object" }
            },
            "additionalProperties": false
          },
          "engines": {
            "type": "object",
            "required": ["engine_files", "subgraphs", "streams", "inferred_count", "source"],
            "properties": {
              "engine_files": { "type": "array", "items": { "type": "string" } },
              "subgraphs": { "type": "array", "items": {} },
              "streams": { "type": "array", "items": {} },
              "inferred_count": { "type": ["integer", "null"] },
              "source": { "type": "string" }
            },
            "additionalProperties": false
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "layer_index", "layer_type", "raw_layer_type", "time_ms", "avg_ms", "median_ms", "percentage", "tags"],
              "properties": {
                "name": { "type": ["string", "null"] },
                "layer_index": { "type": "integer", "minimum": 0 },
                "layer_type": { "type": "string" },
                "raw_layer_type": { "type": "string" },
                "tactic": { "type": "string" },
                "time_ms": { "type": "number" },
                "avg_ms": { "type": "number" },
                "median_ms": { "type": "number" },
                "percentage": { "type": "number" },
                "tags": { "type": "array", "items": { "type": "string" } }
              },
              "additionalProperties": false
            }
          },
          "type_breakdown": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "count", "time_ms", "percentage"],
              "properties": {
                "name": { "type": "string" },
                "count": { "type": "integer", "minimum": 0 },
                "time_ms": { "type": "number" },
                "percentage": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "tag_breakdown": { "$ref": "#/properties/results/items/properties/type_breakdown" },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["score", "title", "evidence", "next_check", "confidence"],
              "properties": {
                "score": { "type": "number" },
                "title": { "type": "string" },
                "evidence": { "type": "string" },
                "next_check": { "type": "string" },
                "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
              },
              "additionalProperties": false
            }
          },
          "positives": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
